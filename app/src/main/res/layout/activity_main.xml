<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="#FFFFFF"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal"
    tools:context=".MainActivity">

    <!-- Título Principal -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/titulo_panel"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="8dp"
        android:textColor="#000000" />

    <!-- Nombre del Alumno -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ismael Hernandez"
        android:textSize="16sp"
        android:layout_marginBottom="32dp"
        android:textColor="#666666" />

    <!-- Contenedor del Estado -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#E3F2FD"
        android:padding="16dp"
        android:layout_marginBottom="32dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvEstadoModelo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/estado_inicial"
            android:textSize="16sp"
            android:textColor="#1565C0"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Botón -->
    <Button
        android:id="@+id/btnSincronizar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/texto_boton"
        android:textSize="16sp"
        android:padding="12dp" />

</LinearLayout>